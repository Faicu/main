    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "adm-zip": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.3",
